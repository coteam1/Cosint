# All keys are optional - the app degrades gracefully without them.

# Have I Been Pwned (paid, ~$4/mo). Without it the app still uses the free
# XposedOrNot and LeakCheck public endpoints.
HIBP_API_KEY=

# Numverify phone enrichment (free tier available). libphonenumber works offline
# without this.
NUMVERIFY_KEY=

# Behaviour
HTTP_TIMEOUT=15
MODULE_TIMEOUT=180
MAX_CONCURRENT_MODULES=6
MAX_PIVOTS=3

# Comma separated module names to switch off, e.g. holehe,ghunt
DISABLED_MODULES=

DATA_DIR=/app/data
